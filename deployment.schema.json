  "additionalProperties": true,
  "properties": {
    "authority_source": {
      "minLength": 1,
      "type": "string"
    },
    "jurisdiction": {
      "minLength": 1,
      "type": "string"
    },
    "organization": {
      "minLength": 1,
      "type": "string"
    },
    "privacy_policy": {
      "minLength": 1,
      "type": "string"
    }
  },
